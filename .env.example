# Copy this file to .env and fill in YOUR OWN values. Never commit .env.
#   cp .env.example .env
# Restart the server after editing.

# Local server (optional)
HOST=127.0.0.1
PORT=8000

# X API credentials of the end user (optional, from developer.x.com).
# NOTE: the X API integration is not implemented in this release. Setting a
# key only changes the reported state from "not_configured" to
# "not_implemented"; no request is sent to X and the limit check still
# relies on manual evidence.
X_API_BEARER_TOKEN=
X_API_CLIENT_ID=
X_API_CLIENT_SECRET=

